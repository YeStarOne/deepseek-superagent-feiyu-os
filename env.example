# 只留键名，不留值。复制为 .env 后填写；.env 永不入仓。
# 通用
WORKSPACE=${WORKSPACE}                 # 工作目录，如 ${HOME}/work
TZ=Asia/Shanghai

# 服务器 / 网络
HOST_TAILSCALE=${HOST_TAILSCALE}       # 服务器 tailnet 地址
HOST_PUBLIC=${HOST_PUBLIC}             # 服务器公网地址（可选）
PC_TAILSCALE=${PC_TAILSCALE}           # 客户端机器 tailnet 地址

# 平台
DSH_HOME=${HOME}/.dsh
DSH_WEB_PORT=3080
DSH_ORCH_PORT=3082
DSH_MEMORY_MAX=896M
DSH_HEAP_MAX=640M

# 模型
API_BASE=${API_BASE}
API_KEY=${API_KEY}
MODEL_MAIN=${MODEL_MAIN}
MODEL_FALLBACK=${MODEL_FALLBACK}

# OneBot / QQ
BOT_QQ=${BOT_QQ}
ONEBOT_WS=ws://127.0.0.1:6098
OWNER_QQ=${OWNER_QQ}
GROUP_QQ=${GROUP_QQ}
OUTBOX_MIN_INTERVAL=8

# 记忆
MEMORY_DATA_DIR=${WORKSPACE}/memory-data
MEMORY_EMBED_MODEL=${MEMORY_EMBED_MODEL}
MEMORY_EMBED_DIM=1024

# 眼睛
EYE_PORT=8901
EYE_TOKEN=${EYE_TOKEN}
EYE_CLIP_PER_HOUR=30

# 团队
RN_RELAY=http://${HOST_TAILSCALE}:3340/
RN_SESSION=${RN_SESSION}
RN_WAKE_MODEL=${RN_WAKE_MODEL}
RN_WAKE_MODEL_FALLBACK=${RN_WAKE_MODEL_FALLBACK}
RN_WAKE=1

# 调度
SHIFT_INTERVAL_MIN=20
SHIFT_MAX_CONCURRENT=2
